<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivItemFoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título do Registro"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data: --/--/----"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemCoordenadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPS: Lat 0.0 | Lon 0.0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemApiInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Toque para enriquecer dados via API REST"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
